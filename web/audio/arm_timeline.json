      "start": 1041.83,
      "duration": 4.0,
      "end": 1045.83
    },
    {
      "type": "speech",
      "text": "最後に、ゆったりと深呼吸を1回行いましょう。",
      "section": "終了フェーズ",
      "start": 1045.83,
      "duration": 6.36,
      "end": 1052.19
    },
