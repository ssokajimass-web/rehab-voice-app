      "start": 1012.6239999999993
    },
    {
      "type": "speech",
      "text": "お疲れさまでした。腕のトレーニングはこれで終了です。",
      "section": "終了フェーズ",
      "start": 1012.62,
      "duration": 7.63,
      "end": 1020.26
    },
