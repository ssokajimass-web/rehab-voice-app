    {
      "type": "silence",
      "section": "運動2: 肘の曲げ伸ばし",
      "start": 109.82,
      "duration": 4.0,
      "end": 113.82
    },
    {
      "type": "speech",
      "text": "もう一度、息を吐きながら、ゆっくり肘を曲げて。",
      "section": "運動2: 肘の曲げ伸ばし",
      "start": 113.82,
      "duration": 5.5,
