      "start": 1042.17,
      "duration": 4.0,
      "end": 1046.17
    },
    {
      "type": "speech",
      "text": "最後に、ゆったりと深呼吸を1回行いましょう。",
      "section": "終了フェーズ",
      "start": 1046.17,
      "duration": 4.44,
      "end": 1050.61
    },
