      "start": 1012.8639999999994
    },
    {
      "type": "speech",
      "text": "お疲れさまでした。腕のトレーニングはこれで終了です。",
      "section": "終了フェーズ",
      "start": 1012.86,
      "duration": 7.63,
      "end": 1020.5
    },
