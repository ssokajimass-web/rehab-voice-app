      "start": 145.39,
      "duration": 2.0,
      "end": 147.39
    },
    {
      "type": "speech",
      "text": "お腹の上に手を楽に置きます。",
      "section": "運動3: 手指の開きと手首のストレッチ",
      "start": 147.39,
      "duration": 3.86,
      "end": 151.26
    },
