    {
      "type": "silence",
      "section": "導入・準備フェーズ",
      "start": 12.01,
      "duration": 2.0,
      "end": 14.01
    },
    {
      "type": "speech",
      "text": "ご自身で動かせる範囲で大丈夫です。介助の方がいらっしゃる場合は、優しく手を添えてもらってくださいね。",
      "section": "導入・準備フェーズ",
      "start": 14.01,
      "duration": 10.8,
      "end": 24.81
    },
    {
      "type": "silence",
      "section": "導入・準備フェーズ",
      "start": 24.81,
      "duration": 3.0,
      "end": 27.81
    },
    {
      "type": "speech",
      "text": "それでは、軽く息を吸って、吐き出します。",
      "section": "導入・準備フェーズ",
      "start": 27.81,
      "duration": 5.21,
      "end": 33.02
