      "start": 174.86,
      "duration": 2.0,
      "end": 176.86
    },
    {
      "type": "speech",
      "text": "もう一度、手のひらと指を、ふわーっと優しく開きます。",
      "section": "運動3: 手指の開きと手首のストレッチ",
      "start": 176.86,
      "duration": 6.31,
      "end": 183.17
